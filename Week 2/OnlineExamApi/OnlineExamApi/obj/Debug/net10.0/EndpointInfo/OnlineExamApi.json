{
  "openapi": "3.0.4",
  "info": {
    "title": "OnlineExamApi",
    "version": "1.0"
  },
  "paths": {
    "/api/questions": {
      "post": {
        "tags": [
          "Questions"
        ],
        "requestBody": {
          "content": {
