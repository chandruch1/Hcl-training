            "minLength": 1,
            "type": "string"
          },
          "subject": {
            "minLength": 1,
            "type": "string"
          },
          "optionA": {
            "minLength": 1,
            "type": "string"
          },
          "optionB": {
            "minLength": 1,
            "type": "string"
          },
          "optionC": {
            "minLength": 1,
            "type": "string"
          },
          "optionD": {
