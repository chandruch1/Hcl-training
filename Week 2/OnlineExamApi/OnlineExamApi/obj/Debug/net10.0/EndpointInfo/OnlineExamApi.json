          "correctOption",
          "optionA",
          "optionB",
          "optionC",
          "optionD",
          "subject",
          "text"
        ],
        "type": "object",
        "properties": {
          "text": {
            "minLength": 1,
            "type": "string"
          },
          "subject": {
            "minLength": 1,
            "type": "string"
          },
          "optionA": {
            "minLength": 1,
            "type": "string"
          },
          "optionB": {
            "minLength": 1,
            "type": "string"
          },
          "optionC": {
            "minLength": 1,
            "type": "string"
          },
          "optionD": {
            "minLength": 1,
            "type": "string"
          },
          "correctOption": {
            "minLength": 1,
            "pattern": "^[A-Da-d]$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateQuestionDto": {
        "required": [
